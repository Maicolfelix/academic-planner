generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // Lets a query ask for real SQL JOINs (`relationLoadStrategy: 'join'`) instead of one extra query per `include`.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String           @id @default(uuid()) @db.Uuid
  name           String
  // Always stored trimmed + lowercase (normalised in @planner/core), so the plain unique index is enough.
  email          String           @unique
  passwordHash   String
  timezone       String           @default("America/Bogota")
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)
  sessions       Session[]
  periods        AcademicPeriod[]
  subjects       Subject[]
  activities     Activity[]
  scheduleBlocks ScheduleBlock[]
  reminders      Reminder[]
}

// Academic dates are calendar days, not instants: @db.Date has no time and no timezone, so
// "2026-08-03" can never drift to the 2nd through a conversion. The API exchanges "YYYY-MM-DD".
model AcademicPeriod {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @db.Uuid
  name           String
  startDate      DateTime        @db.Date
  endDate        DateTime        @db.Date
  isCurrent      Boolean         @default(false)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects       Subject[]
  scheduleBlocks ScheduleBlock[]
  activities     Activity[]
  // Also in the migration SQL (Prisma cannot express them):
  //  - partial unique index: at most one isCurrent = true per user
  //  - CHECK ("endDate" > "startDate")

  @@index([userId])
}

model Subject {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @db.Uuid
  periodId       String          @db.Uuid
  // As typed by the user (trimmed).
  name           String
  // Normalised name (lowercase, no accents, collapsed spaces): duplicates are compared on this.
  nameKey        String
  professor      String?
  // One of the fixed palette hex values (validated in @planner/core).
  color          String
  description    String?
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  // NoAction (checked at end of statement): a period with subjects cannot be deleted silently,
  // yet deleting a whole user still cascades cleanly.
  period         AcademicPeriod  @relation(fields: [periodId], references: [id], onDelete: NoAction)
  activities     Activity[]
  scheduleBlocks ScheduleBlock[]

  @@unique([periodId, nameKey])
  // Redundant as a key (id is already unique) but required: it is the target of Activity's composite foreign key,
  // which is what makes the database reject an activity whose subject belongs to another period.
  @@unique([id, periodId])
  @@index([userId, periodId])
}

enum ActivityType {
  TASK
  EXAM
  QUIZ
  PROJECT
  PRESENTATION
  WORKSHOP
  READING
  OTHER
}

enum ActivityPriority {
  LOW
  MEDIUM
  HIGH
}

enum ActivityStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

// An activity ALWAYS belongs to a period; a subject is optional (a general activity: a paperwork errand, an advisor
// meeting). The period is stored here and the composite foreign key (subjectId, periodId) -> Subject(id, periodId)
// makes the database itself reject a subject from another period (MATCH SIMPLE: it is not checked while subjectId is
// NULL). The period never changes after creation. "Overdue" is NOT stored: it is derived (dueAt < now AND status != COMPLETED).
model Activity {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  periodId    String           @db.Uuid
  subjectId   String?          @db.Uuid
  title       String
  description String?
  type        ActivityType     @default(TASK)
  priority    ActivityPriority @default(MEDIUM)
  status      ActivityStatus   @default(PENDING)
  // An instant (UTC). With hasTime = false it is the END of the user's local day (23:59:59.999).
  dueAt       DateTime         @db.Timestamptz(3)
  hasTime     Boolean          @default(false)
  // Set exactly while status = COMPLETED (also enforced by a CHECK in the migration).
  completedAt DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  // NoAction: a period or subject with activities cannot be deleted silently, yet deleting a whole user cascades.
  period      AcademicPeriod   @relation(fields: [periodId], references: [id], onDelete: NoAction)
  subject     Subject?         @relation(fields: [subjectId, periodId], references: [id, periodId], onDelete: NoAction)

  reminders Reminder[]

  @@index([userId, dueAt])
  @@index([userId, status])
  @@index([userId, periodId, dueAt])
  @@index([subjectId])
}

enum ReminderKind {
  AUTO
  MANUAL
}

enum ReminderStatus {
  PENDING
  SHOWN
  CANCELLED
}

// An internal in-app reminder. It stores only WHEN (and a reference to the activity): the message is
// derived from the activity at display time, so renaming an activity renames its reminders.
// AUTO reminders come from the per-type rules and carry the offset they were computed with
// (remindAt = dueAt + offsetMinutes, always negative); MANUAL ones were chosen by the student and are
// never recomputed. Hand-written constraints (in the migration): AUTO <=> negative offset, and a
// partial unique index so an activity can never hold two AUTO reminders with the same offset.
model Reminder {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  activityId    String         @db.Uuid
  remindAt      DateTime       @db.Timestamptz(3)
  kind          ReminderKind
  status        ReminderStatus @default(PENDING)
  offsetMinutes Int?
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Cascade: deleting an activity deletes its reminders (the service also handles completion explicitly).
  activity      Activity       @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([userId, status, remindAt])
  @@index([activityId])
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  // SHA-256 (hex) of the random cookie token. The plain token is never stored.
  tokenHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt DateTime? @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum ScheduleBlockType {
  CLASS
  STUDY
  ACADEMIC_PERSONAL
}

enum RecurrenceType {
  NONE
  WEEKLY
}

// One row per block OR per weekly series: occurrences are expanded at read time for the requested
// range (never one row per week). startAt/endAt are the instants of the FIRST (or only) occurrence;
// a weekly series repeats that local wall-clock time every 7 calendar days up to `recurrenceUntil`
// (a local DATE, inclusive). The weekday is not stored: it is the weekday of the first occurrence in
// the user's timezone, so it can never contradict it. Hand-written CHECKs live in the migration.
model ScheduleBlock {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @db.Uuid
  // Unlike Activity, a block belongs to a period directly: a study session may have no subject.
  periodId        String            @db.Uuid
  subjectId       String?           @db.Uuid
  title           String
  type            ScheduleBlockType
  startAt         DateTime          @db.Timestamptz(3)
  endAt           DateTime          @db.Timestamptz(3)
  recurrenceType  RecurrenceType    @default(NONE)
  recurrenceUntil DateTime?         @db.Date
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  // NoAction: a period or subject that still has blocks cannot be deleted silently,
  // yet deleting a whole user cascades cleanly.
  period          AcademicPeriod    @relation(fields: [periodId], references: [id], onDelete: NoAction)
  subject         Subject?          @relation(fields: [subjectId], references: [id], onDelete: NoAction)

  @@index([userId, startAt])
  @@index([periodId])
  @@index([subjectId])
}
