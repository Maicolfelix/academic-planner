generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // Lets a query ask for real SQL JOINs (`relationLoadStrategy: 'join'`) instead of one extra query per `include`.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  // Always stored trimmed + lowercase (normalised in @planner/core), so the plain unique index is enough.
  email           String           @unique
  passwordHash    String
  timezone        String           @default("America/Bogota")
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  sessions        Session[]
  periods         AcademicPeriod[]
  subjects        Subject[]
  activities      Activity[]
  scheduleBlocks  ScheduleBlock[]
  reminders       Reminder[]
  // Exactly one per user, created with the account (and by the migration for the ones that already existed).
  profile         UserProfile?
  // The formations the user takes (0..n; none is valid: personal-only, teacher-only, older accounts).
  studyTracks     StudyTrack[]
  // Grades (D36). Every row repeats its owner so each repository query is scoped by `userId`.
  gradingProfiles GradingProfile[]
  gradingPeriods  GradingPeriod[]
  evaluations     Evaluation[]
}

// What the person says they use the app for. A description to personalise labels, NEVER an authorization role.
// The kind of study a SUBJECT is. There is no PERSONAL: personal things are activities without a subject.
enum EducationContext {
  UNIVERSITY
  SCHOOL
  OTHER_ACADEMIC
}

enum PrimaryUse {
  UNIVERSITY_STUDENT
  SCHOOL_STUDENT
  OTHER_STUDENT
  TEACHER
  PERSONAL
}

enum StudyTrackStatus {
  ACTIVE
  ARCHIVED
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

/// The educational profile of a user (1:1). `User` stays identity/authentication; nothing here grants or denies anything.
model UserProfile {
  userId           String           @id @db.Uuid
  primaryUse       PrimaryUse?
  // The authority: what the person (or the catalog's canonical entry) says the program is. 1..80 characters.
  programName      String?
  // Optional reference to the small catalog in @planner/core. Never drives behaviour; NOT NULL name when set.
  programKey       String?
  onboardingStatus OnboardingStatus @default(NOT_STARTED)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Also in the migration SQL (Prisma cannot express them):
  //  - CHECK (programName has 1..80 characters)
  //  - CHECK (a programKey implies a programName)
}

/// A formation the user takes (a degree, school, a technical program, a diploma, a language course): "an estudio".
/// It DESCRIBES; nothing here grants or denies anything and no behaviour reads `type` or `name` to decide. There is no
/// PERSONAL type (personal things are not a formation). A period may belong to one (`AcademicPeriod.studyTrackId`); a subject
/// reaches it through its period, never directly; the profile is not linked.
model StudyTrack {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  // The VISIBLE name of the study ("Medicina", "Colegio", "Inglés B2"): 1..80, trimmed. Not necessarily a career.
  name       String
  // Descriptive and correctable at any time. Changing it never touches `Subject.educationContext` (each subject keeps its snapshot).
  type       EducationContext
  // Optional reference to the small catalog in @planner/core: when set, `name` is the catalog's canonical name.
  programKey String?
  isPrimary  Boolean          @default(false)
  // ARCHIVED = finished or paused: it is kept with its history, never deleted to "end" a study.
  status     StudyTrackStatus @default(ACTIVE)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(3)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The periods of this study (a period may also belong to none).
  periods    AcademicPeriod[]
  // Also in the migration SQL (Prisma cannot express them):
  //  - partial unique index: at most one isPrimary = true per user
  //  - CHECK (name has 1..80 characters and is trimmed; programKey has 1..60)
  //  - CHECK (isPrimary implies status = ACTIVE)

  // The target of the composite foreign key a period uses (the database refuses a period of one user pointing
  // at a track of another). `userId` is the leading column of `@@index([userId, status])`, which also serves the plain list.
  @@unique([id, userId])
  @@index([userId, status])
}

// Academic dates are calendar days, not instants: @db.Date has no time and no timezone, so
// "2026-08-03" can never drift to the 2nd through a conversion. The API exchanges "YYYY-MM-DD".
model AcademicPeriod {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @db.Uuid
  name           String
  startDate      DateTime        @db.Date
  endDate        DateTime        @db.Date
  isCurrent      Boolean         @default(false)
  // The level during THIS period (a semester, a school grade...): generic on purpose, a number OR a free-text note, never both.
  studyLevel     Int?
  studyLevelNote String?
  // The study (formation) this period belongs to. NULL is a PERMANENT, valid state (personal organization, teaching, older
  // accounts, a general period): there is no "personal" study. Never derived from the profile, the subjects or the name.
  studyTrackId   String?         @db.Uuid
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Composite (studyTrackId, userId): a period can never point at another user's study (MATCH SIMPLE: not checked while it is
  // NULL). NoAction: studies are archived, never deleted, and one with periods cannot be deleted silently.
  studyTrack     StudyTrack?     @relation(fields: [studyTrackId, userId], references: [id, userId], onDelete: NoAction)
  subjects       Subject[]
  scheduleBlocks ScheduleBlock[]
  activities     Activity[]
  // Grades (D36): the scale, the cuts and the evaluations hang from the period (never from a study or an activity).
  gradingProfile GradingProfile?
  gradingPeriods GradingPeriod[]
  evaluations    Evaluation[]
  // Also in the migration SQL (Prisma cannot express them):
  //  - partial unique indexes: at most one isCurrent = true per user WITHOUT a study, and at most one per study
  //  - CHECK ("endDate" > "startDate")
  //  - CHECK (studyLevel between 1 and 99; studyLevelNote has 1..40 characters; at most one of the two is set)

  @@index([userId])
  @@index([studyTrackId])
}

model Subject {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @db.Uuid
  periodId         String            @db.Uuid
  // As typed by the user (trimmed).
  name             String
  // Normalised name (lowercase, no accents, collapsed spaces): duplicates are compared on this.
  nameKey          String
  professor        String?
  // One of the fixed palette hex values (validated in @planner/core).
  color            String
  description      String?
  // Where the subject comes from (university, school, other structured study). NULL = not specified: never inferred for older
  // subjects and never read as one of the three. It does NOT say whether the subject is graded.
  educationContext EducationContext?
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  // NoAction (checked at end of statement): a period with subjects cannot be deleted silently,
  // yet deleting a whole user still cascades cleanly.
  period           AcademicPeriod    @relation(fields: [periodId], references: [id], onDelete: NoAction)
  activities       Activity[]
  scheduleBlocks   ScheduleBlock[]
  // NoAction: a subject with evaluations cannot be deleted silently (the API answers 409).
  evaluations      Evaluation[]

  @@unique([periodId, nameKey])
  // Redundant as a key (id is already unique) but required: it is the target of Activity's composite foreign key,
  // which is what makes the database reject an activity whose subject belongs to another period.
  @@unique([id, periodId])
  @@index([userId, periodId])
}

enum ActivityType {
  TASK
  EXAM
  QUIZ
  PROJECT
  PRESENTATION
  WORKSHOP
  READING
  OTHER
}

enum ActivityPriority {
  LOW
  MEDIUM
  HIGH
}

enum ActivityStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

// An activity ALWAYS belongs to a period; a subject is optional (a general activity: a paperwork errand, an advisor
// meeting). The period is stored here and the composite foreign key (subjectId, periodId) -> Subject(id, periodId)
// makes the database itself reject a subject from another period (MATCH SIMPLE: it is not checked while subjectId is
// NULL). The period never changes after creation. "Overdue" is NOT stored: it is derived (dueAt < now AND status != COMPLETED).
model Activity {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  periodId    String           @db.Uuid
  subjectId   String?          @db.Uuid
  title       String
  description String?
  type        ActivityType     @default(TASK)
  priority    ActivityPriority @default(MEDIUM)
  status      ActivityStatus   @default(PENDING)
  // An instant (UTC). With hasTime = false it is the END of the user's local day (23:59:59.999).
  dueAt       DateTime         @db.Timestamptz(3)
  hasTime     Boolean          @default(false)
  // Set exactly while status = COMPLETED (also enforced by a CHECK in the migration).
  completedAt DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  // NoAction: a period or subject with activities cannot be deleted silently, yet deleting a whole user cascades.
  period      AcademicPeriod   @relation(fields: [periodId], references: [id], onDelete: NoAction)
  subject     Subject?         @relation(fields: [subjectId, periodId], references: [id, periodId], onDelete: NoAction)

  reminders Reminder[]

  // The target of the composite foreign key an Evaluation uses to link an activity of the SAME subject (see Evaluation).
  @@unique([id, subjectId])
  @@index([userId, dueAt])
  @@index([userId, status])
  @@index([userId, periodId, dueAt])
  @@index([subjectId])
}

enum ReminderKind {
  AUTO
  MANUAL
}

enum ReminderStatus {
  PENDING
  SHOWN
  CANCELLED
}

// An internal in-app reminder. It stores only WHEN (and a reference to the activity): the message is
// derived from the activity at display time, so renaming an activity renames its reminders.
// AUTO reminders come from the per-type rules and carry the offset they were computed with
// (remindAt = dueAt + offsetMinutes, always negative); MANUAL ones were chosen by the student and are
// never recomputed. Hand-written constraints (in the migration): AUTO <=> negative offset, and a
// partial unique index so an activity can never hold two AUTO reminders with the same offset.
model Reminder {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  activityId    String         @db.Uuid
  remindAt      DateTime       @db.Timestamptz(3)
  kind          ReminderKind
  status        ReminderStatus @default(PENDING)
  offsetMinutes Int?
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Cascade: deleting an activity deletes its reminders (the service also handles completion explicitly).
  activity      Activity       @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([userId, status, remindAt])
  @@index([activityId])
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  // SHA-256 (hex) of the random cookie token. The plain token is never stored.
  tokenHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt DateTime? @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum ScheduleBlockType {
  CLASS
  STUDY
  ACADEMIC_PERSONAL
}

enum RecurrenceType {
  NONE
  WEEKLY
}

// One row per block OR per weekly series: occurrences are expanded at read time for the requested
// range (never one row per week). startAt/endAt are the instants of the FIRST (or only) occurrence;
// a weekly series repeats that local wall-clock time every 7 calendar days up to `recurrenceUntil`
// (a local DATE, inclusive). The weekday is not stored: it is the weekday of the first occurrence in
// the user's timezone, so it can never contradict it. Hand-written CHECKs live in the migration.
model ScheduleBlock {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @db.Uuid
  // Unlike Activity, a block belongs to a period directly: a study session may have no subject.
  periodId        String            @db.Uuid
  subjectId       String?           @db.Uuid
  title           String
  type            ScheduleBlockType
  startAt         DateTime          @db.Timestamptz(3)
  endAt           DateTime          @db.Timestamptz(3)
  recurrenceType  RecurrenceType    @default(NONE)
  recurrenceUntil DateTime?         @db.Date
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  // NoAction: a period or subject that still has blocks cannot be deleted silently,
  // yet deleting a whole user cascades cleanly.
  period          AcademicPeriod    @relation(fields: [periodId], references: [id], onDelete: NoAction)
  subject         Subject?          @relation(fields: [subjectId], references: [id], onDelete: NoAction)

  @@index([userId, startAt])
  @@index([periodId])
  @@index([subjectId])
}

// GRADES (D36). One numeric scale per period; scores are integers in thousandths so nothing drifts (4.3 = 4300). Only a period that
// belongs to a study can be graded (the service checks it; a period cannot lose its study while it has this row).
model GradingProfile {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  periodId  String         @unique @db.Uuid
  minMilli  Int
  maxMilli  Int
  passMilli Int
  // Digits shown (0..3). Presentation only: the stored scores and every comparison are exact.
  decimals  Int
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Cascade: the configuration alone (no evaluations) goes with its period.
  period    AcademicPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  // Also in the migration SQL (Prisma cannot express them):
  //  - CHECK (minMilli >= 0, maxMilli <= 100000, minMilli < maxMilli, passMilli between them, decimals between 0 and 3)

  @@index([userId])
}

// A "corte" / school evaluation period / stage, shared by every subject of the period. `finalShareBp` = its weight in the FINAL
// grade (basis points: 3000 = 30 %); the sum over a period is at most 10000 (checked by the service under a lock).
model GradingPeriod {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @db.Uuid
  periodId     String         @db.Uuid
  name         String
  // Assigned by the server on creation (1, 2, 3…); the cuts are listed in this order.
  position     Int
  finalShareBp Int
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(3)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  period       AcademicPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  // NoAction: a cut with evaluations cannot be deleted silently (the API answers 409).
  evaluations  Evaluation[]
  // Also in the migration SQL: CHECK (finalShareBp between 1 and 10000; position >= 1; name has 1..80 characters and is trimmed)

  // The target of Evaluation's composite foreign key (a cut of another period is refused by the database).
  @@unique([id, periodId])
  @@unique([periodId, position])
  @@index([userId, periodId])
}

// One graded piece of ONE subject. Its weight inside its cut is `periodShareBp`; the sum per (subject, cut) is at most 10000
// (service, under the same lock). `scoreMilli` is ALWAYS in the profile's scale; `rawEarnedMilli`/`rawMaxMilli` keep what was
// reported ("18 of 20") and never replace it. `activityId` links an activity of the SAME subject (0..N evaluations per activity):
// the composite foreign key (activityId, subjectId) -> Activity(id, subjectId) is written by hand in the migration with
// ON DELETE SET NULL ("activityId") — Prisma cannot express a column list there — so it is a plain column here, and deleting the
// activity only unlinks the evaluation.
model Evaluation {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @db.Uuid
  periodId        String         @db.Uuid
  subjectId       String         @db.Uuid
  gradingPeriodId String         @db.Uuid
  activityId      String?        @db.Uuid
  name            String
  periodShareBp   Int
  scoreMilli      Int?
  rawEarnedMilli  Int?
  rawMaxMilli     Int?
  scoredAt        DateTime?      @db.Timestamptz(3)
  // The student's grade of a whole cut for this subject, with no breakdown (always 100 % of the cut, always scored, no activity).
  isCutGrade      Boolean        @default(false)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  period          AcademicPeriod @relation(fields: [periodId], references: [id], onDelete: NoAction)
  // Composite: the subject and the cut must both belong to this evaluation's period (the database refuses otherwise).
  subject         Subject        @relation(fields: [subjectId, periodId], references: [id, periodId], onDelete: NoAction)
  gradingPeriod   GradingPeriod  @relation(fields: [gradingPeriodId, periodId], references: [id, periodId], onDelete: NoAction)
  // Also in the migration SQL (Prisma cannot express them):
  //  - FOREIGN KEY ("activityId", "subjectId") -> "Activity"("id", "subjectId") ON DELETE SET NULL ("activityId")
  //  - CHECK (periodShareBp between 1 and 10000; scoreMilli between 0 and 100000; name has 1..80 characters and is trimmed)
  //  - CHECK (the raw pair is both-or-none, needs a score, rawMaxMilli > 0 and rawEarnedMilli between 0 and rawMaxMilli)
  //  - CHECK (scoredAt is set exactly while scoreMilli is)
  //  - CHECK (isCutGrade implies periodShareBp = 10000, no activity and a score) and a partial unique index (subjectId, gradingPeriodId) WHERE isCutGrade

  @@index([userId, periodId])
  @@index([subjectId])
  @@index([gradingPeriodId])
  @@index([activityId])
}
