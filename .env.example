# Copy to .env (cp .env.example .env). Never commit .env.

# --- API ---
NODE_ENV=development
API_PORT=3000
# Allowed browser origin(s), comma separated. In dev the Vite proxy makes requests same-origin.
CORS_ORIGIN=http://localhost:5173

# --- Database (matches docker-compose.yml; host port 5433) ---
DATABASE_URL=postgresql://planner:planner@localhost:5433/academic_planner

# --- Web ---
WEB_PORT=5173
# Where the Vite dev proxy forwards /api
API_PROXY_TARGET=http://localhost:3000

# --- Test database (integration tests + Playwright). MUST end in _test; created and migrated automatically. ---
TEST_DATABASE_URL=postgresql://planner:planner@localhost:5433/academic_planner_test

# --- Auth rate limits (per IP) ---
# Failed logins per 15 min (successful logins are not counted)
LOGIN_RATE_LIMIT_MAX=10
# Registrations per hour
REGISTER_RATE_LIMIT_MAX=20

# --- Schedule import (OCR) ---
# Imports per 10 min per IP
SCHEDULE_IMPORT_RATE_LIMIT_MAX=10
